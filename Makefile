CC = gcc

# BUILD is either "release" or "debug" (e.g. make BUILD=debug)
BUILD ?= release

CPPFLAGS = -Iinclude -MMD -MP
CFLAGS   = -std=c11 -Wall -Wextra -Wpedantic

ifeq ($(BUILD),release)
  CFLAGS += -O3 -march=native -DNDEBUG
else ifeq ($(BUILD),debug)
  CFLAGS  += -O0 -g -fsanitize=address,undefined -fno-omit-frame-pointer
  LDFLAGS += -fsanitize=address,undefined
else
  $(error BUILD must be "release" or "debug")
endif

BUILDDIR = build/$(BUILD)

# Sources shared by the programs
GAME_SRC   = src/game.c
UI_SRC     = src/user_interface.c
SOLVER_SRC = src/solver.c

GAME_OBJ   = $(GAME_SRC:%.c=$(BUILDDIR)/%.o)
UI_OBJ     = $(UI_SRC:%.c=$(BUILDDIR)/%.o)
SOLVER_OBJ = $(SOLVER_SRC:%.c=$(BUILDDIR)/%.o)

# Programs
PLAY_OBJ   = $(BUILDDIR)/src/main_play.o
SOLVE_OBJ  = $(BUILDDIR)/src/main_solver.o

PLAY_BIN   = $(BUILDDIR)/connect4
SOLVER_BIN = $(BUILDDIR)/c4solver

.PHONY: all play solver run debug bench data clean

all: play solver

play: $(PLAY_BIN)

solver: $(SOLVER_BIN)

run: play
	./$(PLAY_BIN)

debug:
	$(MAKE) BUILD=debug play solver

$(PLAY_BIN): $(PLAY_OBJ) $(GAME_OBJ) $(UI_OBJ)
	$(CC) $(LDFLAGS) $^ -o $@

$(SOLVER_BIN): $(SOLVE_OBJ) $(GAME_OBJ) $(SOLVER_OBJ)
	$(CC) $(LDFLAGS) $^ -o $@

$(BUILDDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# Benchmark (always built in release mode). Examples:
#   make data                                  download the 6 test sets
#   make bench STEP=3 SET=End-Easy LIMIT=100   first 100 positions of End-Easy, logged as blog part 3
#   make bench STEP=6 LABEL="bitboard"         all 6 sets
#   make bench WEAK=1                          weak solver mode
#   make bench PERPOS=bench/per_position.csv   also write one line per position
LIMIT   ?= 0
RESULTS ?= bench/results.csv

bench:
	$(MAKE) BUILD=release solver
	bench/bench.sh -s build/release/c4solver -o $(RESULTS) -n $(LIMIT) \
		$(if $(STEP),-e $(STEP)) $(if $(LABEL),-l "$(LABEL)") $(if $(WEAK),-w) $(if $(PERPOS),-p $(PERPOS)) $(SET)

data:
	bench/bench.sh download

clean:
	rm -rf build

# Header dependencies generated by -MMD
-include $(PLAY_OBJ:.o=.d) $(SOLVE_OBJ:.o=.d) $(GAME_OBJ:.o=.d) $(UI_OBJ:.o=.d) $(SOLVER_OBJ:.o=.d)
